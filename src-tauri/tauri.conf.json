{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Just another Tempo Trainer",
  "version": "1.1.0",
  "identifier": "io.github.justanothertempotrainer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Just another Tempo Trainer",
        "width": 1060,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' data: blob: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Slow down songs to practice, without changing pitch",
    "longDescription": "Open an audio file, detect its BPM and play it back at the tempo you choose, without changing the pitch. An A–B loop repeats difficult passages.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNzRCMjU5MkZERTYyMjcKUldRbll0NHZXYkowWW1ScWpIeW8xU2hSVEd4aWtqQldMa1BqRW9oeSsxSFRPOGFuQlhJenZ1NWYK",
      "endpoints": [
        "https://github.com/conlaccento/just-another-tempo-trainer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
